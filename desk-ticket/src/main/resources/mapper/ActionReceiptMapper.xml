<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yangaobo.servicedesk.ticket.mapper.ActionReceiptMapper">
  <resultMap id="receipt" type="com.yangaobo.servicedesk.ticket.model.entity.ActionReceiptEntity" autoMapping="true">
    <id column="id" property="id"/>
    <result column="result_snapshot" property="resultSnapshot" javaType="com.fasterxml.jackson.databind.JsonNode"
      typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
  </resultMap>
  <sql id="columns">
    id,actor_id,client_action_id,action_type,request_hash,source_draft_id,source_draft_root_id,
    ticket_id,booking_id,result_code,result_snapshot,created_at
  </sql>
  <select id="byAction" resultMap="receipt">
    SELECT <include refid="columns"/> FROM sd_action_receipt WHERE actor_id=#{actor} AND client_action_id=#{key}
  </select>
  <select id="byDraft" resultMap="receipt">
    SELECT <include refid="columns"/> FROM sd_action_receipt WHERE source_draft_root_id=#{root}
  </select>
</mapper>
