<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yangaobo.servicedesk.ticket.mapper.ServiceEventMapper">
  <resultMap id="entityMap" type="com.yangaobo.servicedesk.ticket.model.entity.ServiceEventEntity" autoMapping="true">
    <id column="id" property="id"/>
    <result column="details" property="details"
      javaType="com.fasterxml.jackson.databind.JsonNode"
      typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
  </resultMap>

  <select id="lock" resultMap="entityMap">
    SELECT
      id,
      service_item_id,
      entitlement_id,
      actor_id,
      event_type,
      client_action_id,
      request_hash,
      details,
      created_at
    FROM it_service_event
    WHERE id = #{id}
    FOR UPDATE
  </select>

  <sql id="entityColumns">
    id,
    service_item_id,
    entitlement_id,
    actor_id,
    event_type,
    client_action_id,
    request_hash,
    details,
    created_at
  </sql>

  <sql id="countEventsFromWhere">
    FROM it_service_event
    <where>
      <choose>
        <when test="entitlement">
          entitlement_id = #{id}
        </when>
        <otherwise>
          service_item_id = #{id}
          AND entitlement_id IS NULL
        </otherwise>
      </choose>
    </where>
  </sql>

  <select id="listEvents" resultMap="entityMap">
    SELECT
      <include refid="entityColumns"/>
    <include refid="countEventsFromWhere"/>
    ORDER BY created_at, id
    LIMIT #{limit}
    OFFSET #{offset}
  </select>

  <select id="countEvents" resultType="long">
    SELECT COUNT(*)
    <include refid="countEventsFromWhere"/>
  </select>
</mapper>
