<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yangaobo.servicedesk.ticket.mapper.NotificationMapper">
  <resultMap id="entityMap" type="com.yangaobo.servicedesk.ticket.model.entity.NotificationEntity" autoMapping="true">
    <id column="id" property="id"/>
  </resultMap>

  <select id="lock" resultMap="entityMap">
    SELECT
      id,
      ticket_id,
      event_id,
      recipient_id,
      read_at,
      created_at
    FROM sd_notification
    WHERE id = #{id}
    FOR UPDATE
  </select>
</mapper>
