<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yangaobo.servicedesk.knowledge.mapper.DocumentEventMapper">
  <resultMap id="entityMap" type="com.yangaobo.servicedesk.knowledge.model.entity.DocumentEventEntity" autoMapping="true">
    <id column="id" property="id"/>
    <result column="details" property="details"
      javaType="com.fasterxml.jackson.databind.JsonNode"
      typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
  </resultMap>

  <select id="lock" resultMap="entityMap">
    SELECT
      id,
      document_id,
      actor_id,
      event_type,
      related_document_id,
      details,
      created_at
    FROM kb_document_event
    WHERE id = #{id}
    FOR UPDATE
  </select>

  <select id="decisionTime" resultType="java.time.LocalDateTime">
    SELECT UTC_TIMESTAMP(6)
  </select>

  <sql id="entityColumns">
    id,
    document_id,
    actor_id,
    event_type,
    related_document_id,
    details,
    created_at
  </sql>

  <sql id="countEventsFromWhere">
    FROM kb_document_event
    <where>
      document_id = #{documentId}
    </where>
  </sql>

  <select id="listEvents" resultMap="entityMap">
    SELECT
      <include refid="entityColumns"/>
    <include refid="countEventsFromWhere"/>
    ORDER BY created_at DESC, id
    LIMIT #{limit}
    OFFSET #{offset}
  </select>

  <select id="countEvents" resultType="long">
    SELECT COUNT(*)
    <include refid="countEventsFromWhere"/>
  </select>
</mapper>
