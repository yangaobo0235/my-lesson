<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.yangaobo.contracts</groupId>
    <artifactId>client-generation</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.15.0</version>
                <executions>
                    <execution>
                        <id>generate-java-client</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/internal-tools.openapi.yaml</inputSpec>
                            <generatorName>java</generatorName>
                            <library>native</library>
                            <output>${project.build.directory}/generated/java</output>
                            <apiPackage>com.yangaobo.contracts.client.api</apiPackage>
                            <modelPackage>com.yangaobo.contracts.client.model</modelPackage>
                            <invokerPackage>com.yangaobo.contracts.client</invokerPackage>
                            <groupId>com.yangaobo.contracts</groupId>
                            <artifactId>mylesson-internal-tools-client</artifactId>
                            <artifactVersion>1.1.0</artifactVersion>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <dateLibrary>java8</dateLibrary>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <serializationLibrary>jackson</serializationLibrary>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-python-client</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/internal-tools.openapi.yaml</inputSpec>
                            <generatorName>python</generatorName>
                            <output>${project.build.directory}/generated/python</output>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <packageName>mylesson_internal_tools_client</packageName>
                                <projectName>mylesson-internal-tools-client</projectName>
                                <packageVersion>1.1.0</packageVersion>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
