<view class="page">
  <view class="title">待确认操作</view>
  <view class="subtitle">购物车、学习计划等写操作需要你明确确认</view>
  <van-empty wx:if="{{!loading && !approvals.length}}" description="暂无审批任务"/>
  <view wx:for="{{approvals}}" wx:key="id" class="approval">
    <view class="approval-head"><text>{{item.actionType}}</text><van-tag type="{{item.status === 'PENDING' ? 'warning' : 'default'}}">{{item.status}}</van-tag></view>
    <view class="reason">{{item.reason || '请确认是否执行该操作'}}</view>
    <view class="expires">有效期至 {{item.expiresAt}}</view>
    <view wx:if="{{item.status === 'PENDING'}}" class="actions">
      <van-button size="small" type="danger" plain data-id="{{item.id}}" data-action="reject" bind:tap="decide">拒绝</van-button>
      <van-button size="small" type="primary" data-id="{{item.id}}" data-action="approve" bind:tap="decide">批准</van-button>
    </view>
  </view>
</view>
