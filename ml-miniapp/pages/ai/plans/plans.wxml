<view class="page">
  <view class="title">学习计划</view>
  <view class="subtitle">已确认并保存的计划会出现在这里</view>
  <van-empty wx:if="{{!loading && !plans.length}}" description="暂无学习计划"/>
  <view wx:for="{{plans}}" wx:key="id" class="plan">
    <view class="plan-head"><text>{{item.goal}}</text><van-tag type="{{item.status === 'ACTIVE' ? 'success' : 'default'}}">{{item.status}}</van-tag></view>
    <view class="meta">每天 {{item.availableMinutesPerDay}} 分钟 · 预计 {{item.estimatedWeeks}} 周</view>
    <view wx:for="{{item.courses}}" wx:for-item="course" wx:key="courseId" class="course">
      <text class="order">{{course.order}}</text>
      <view><view>{{course.title}}</view><view class="objective">{{course.objective}}</view></view>
    </view>
  </view>
</view>
