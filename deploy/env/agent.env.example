APP_ENV=production
APP_PORT=24109
LOG_LEVEL=INFO

# Use the existing PostgreSQL/pgvector and Redis services. Inject real secrets at deploy time.
AGENT_DATABASE_URL=postgresql+asyncpg://mylesson_agent:change-me@infra.example.com:5432/mylesson_agent
AGENT_MIGRATION_DATABASE_URL=postgresql+psycopg://mylesson_agent:change-me@infra.example.com:5432/mylesson_agent
REDIS_URL=redis://infra.example.com:6379/1
AI_SEARCH_SERVICE_URL=http://ml-ai-search:24111
AI_KEYWORD_BACKEND_ENABLED=true

AI_DELEGATION_SECRET=generate-at-least-32-random-bytes
AI_INTERNAL_TOKEN=generate-an-independent-service-token
DASHSCOPE_API_KEY=change-me
AI_CHAT_MODEL=qwen3-max
AI_ROUTER_MODEL=qwen-flash
AI_EMBEDDING_MODEL=text-embedding-v4
AI_RERANK_MODEL=qwen3-rerank

VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RRF_TOP_K=20
RRF_K=60
RRF_VECTOR_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=1.0
VECTOR_MINIMUM_SCORE=0.45
RERANK_MINIMUM_SCORE=0.45

WORKER_POLL_SECONDS=0.5
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_SECONDS=60
CONVERSATION_LOCK_TTL_SECONDS=120

USER_SERVICE_URL=http://ml-user:24102
COURSE_SERVICE_URL=http://ml-course:24103
SALE_SERVICE_URL=http://ml-sale:24104
ORDER_SERVICE_URL=http://ml-order:24105

OTEL_EXPORTER_OTLP_ENDPOINT=http://infra.example.com:4317
LANGFUSE_HOST=http://infra.example.com:13000
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_SECRET_KEY=change-me
