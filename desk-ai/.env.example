DESK_AI_QDRANT__URL="http://192.168.23.66:6333"
DESK_AI_REDIS__HOST="192.168.23.66"
DESK_AI_REDIS__KEY_PREFIX="desk:test:ai:"
DESK_AI_REDIS__PASSWORD=""
DESK_AI_REDIS__USERNAME="default"
DESK_AI_RESOURCE_ENV="test"
DESK_AI_ROCKETMQ__ACCESS_KEY=""
DESK_AI_ROCKETMQ__CONSUMER_GROUP="desk-ai-index-command-test"
DESK_AI_ROCKETMQ__ENDPOINTS="192.168.23.66:8081"
DESK_AI_ROCKETMQ__SECRET_KEY=""
