# 开发迁移凭据留空时复用本服务MySQL账号；生产必须单独填写。
DESK_AI_MYSQL__MIGRATION_USERNAME=""
DESK_AI_MYSQL__MIGRATION_PASSWORD=""

# AI内部监听的调用服务凭据，与AI出站SERVICE_TOKEN分开。
