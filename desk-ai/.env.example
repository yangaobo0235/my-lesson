# AI本机配置：复制为同目录.env，在desk-ai目录启动python -m servicedesk_ai。
# 仅由get_settings在开发环境加载；生产通过进程环境设置DESK_AI_ENVIRONMENT=prod，不读取.env。
# 使用Pydantic Settings/python-dotenv标准语法；含空格、#或反斜杠时保留引号及转义。
# 组件密码/密钥需填写；开发迁移凭据可空并复用MySQL账号；MinerU未认证时API_KEY可空，RPC随真实业务启用。
DESK_AI_ELASTICSEARCH__INDEX="desk_chunks_test_te4_1024_v1"
DESK_AI_ELASTICSEARCH__PASSWORD=""
DESK_AI_ELASTICSEARCH__URL="http://192.168.23.66:9200"
DESK_AI_ELASTICSEARCH__USERNAME="desk_ai_test"
DESK_AI_ENVIRONMENT="dev"
DESK_AI_HTTP_HOST="127.0.0.1"
DESK_AI_INFRASTRUCTURE_ENABLED="true"
DESK_AI_MIGRATIONS_ENABLED="true"
DESK_AI_EXECUTION__TOTAL_SECONDS="180"
DESK_AI_EXECUTION__MAX_MODEL_CALLS="8"
DESK_AI_EXECUTION__MAX_TOOL_CALLS="12"
DESK_AI_EXECUTION__MAX_INPUT_TOKENS="12000"
DESK_AI_EXECUTION__MAX_OUTPUT_TOKENS="2048"
DESK_AI_EXECUTION__TOTAL_TOKENS="32000"
DESK_AI_EXECUTION__READONLY_TOOL_CONCURRENCY="4"
DESK_AI_EXECUTION__TOOL_TIMEOUT_SECONDS="10"
DESK_AI_EXECUTION__SOURCE_LIMIT="64"
DESK_AI_EXECUTION__FACTS_PER_ROUND="30"
DESK_AI_MINERU__API_KEY=""
DESK_AI_MINERU__URL="http://192.168.23.66:28000"
DESK_AI_MODEL__API_KEY=""
DESK_AI_MODEL__BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DESK_AI_MODEL__CHAT_MODEL="qwen3.8-flash"
DESK_AI_MODEL__DIMENSIONS="1024"
DESK_AI_MODEL__EMBEDDING_MODEL="text-embedding-v4"
DESK_AI_MODEL__MAX_OUTPUT_TOKENS="2048"
DESK_AI_MODEL__TEMPERATURE="0.2"
DESK_AI_MODEL__TIMEOUT_SECONDS="60"
DESK_AI_MYSQL__DATABASE="desk_ai_test"
DESK_AI_MYSQL__HOST="192.168.23.66"
DESK_AI_MYSQL__PASSWORD=""
DESK_AI_MYSQL__USERNAME="root"
DESK_AI_OBSERVABILITY__LOG_DIRECTORY="../.local/runtime/logs/desk-ai"
DESK_AI_OBSERVABILITY__SAMPLE_RATIO="0.1"
DESK_AI_OBSERVABILITY__URL="http://192.168.23.66:9411"
DESK_AI_QDRANT__API_KEY=""
