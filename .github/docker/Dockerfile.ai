# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.13.7 AS uv
FROM python:3.12.16-slim-bookworm AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /workspace/desk-ai
COPY desk-ai/pyproject.toml desk-ai/uv.lock desk-ai/.python-version ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-install-project
COPY desk-ai/src/ src/
COPY desk-api/src/main/proto/ /workspace/desk-api/src/main/proto/
COPY .github/scripts/generate_contracts.py .github/scripts/build_ai.py /workspace/.github/scripts/
RUN --mount=type=cache,target=/root/.cache/uv \
    /opt/venv/bin/python /workspace/.github/scripts/build_ai.py --output /wheels \
    && uv sync --locked --no-dev --no-install-project \
    && uv pip install --python /opt/venv/bin/python --no-deps /wheels/*.whl \
    && uv pip check --python /opt/venv/bin/python

FROM python:3.12.16-slim-bookworm AS runtime
RUN groupadd --gid 10001 desk \
    && useradd --uid 10001 --gid desk --create-home desk \
    && mkdir -p /home/desk/logs/rocketmq_python \
    && chown -R desk:desk /home/desk/logs \
    && mkdir -p /app /var/log/service-desk \
    && chown desk:desk /app /var/log/service-desk
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DESK_AI_ENVIRONMENT=prod \
    DESK_AI_RESOURCE_ENV=prod \
    DESK_AI_HTTP_HOST=0.0.0.0 \
    DESK_AI_OBSERVABILITY__LOG_DIRECTORY=/var/log/service-desk
USER 10001:10001
EXPOSE 26105 26205
ENTRYPOINT ["python", "-m"]
CMD ["servicedesk_ai"]
